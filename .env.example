# Copy to .env. Placeholders only. Never commit your populated .env.
NODE_ENV=development
PORT=8080
DATA_DIR=.data
# Omit for disk-backed embedded PostgreSQL in development only.
DATABASE_URL=
DATABASE_SSL=false
PUBLIC_BASE_URL=http://localhost:8080
DASHBOARD_ORIGIN=http://localhost:5173
# In development, generated and persisted in .data if empty. Required in production.
SESSION_SECRET=
SETUP_TOKEN=
TRUST_PROXY=false

# Both live switches are intentionally OFF. Setting credentials alone never enables calls.
ENABLE_LIVE_AI=false
ENABLE_LIVE_CALLS=false
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ENABLE_SEMANTIC_SEARCH=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Operator-supplied estimates; verify your country, model and current provider pricing.
# Live voice requires positive estimates to reserve a conservative spending envelope.
TWILIO_USD_PER_MINUTE=
AI_VOICE_USD_PER_MINUTE=
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=15000
