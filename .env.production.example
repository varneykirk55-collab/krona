# Example ONLY. Copy to .env on the production host, replace placeholders, chmod 600 .env.
NODE_ENV=production
PORT=8080
APP_DOMAIN=companion.example.com
PUBLIC_BASE_URL=https://companion.example.com
DASHBOARD_ORIGIN=https://companion.example.com
DATA_DIR=.data
# Use independent random values. The same URL-encoded database password goes in both fields.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://krona:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@database:5432/krona
DATABASE_SSL=false
TRUST_PROXY=true
SESSION_SECRET=
SETUP_TOKEN=
ENABLE_LIVE_AI=false
ENABLE_LIVE_CALLS=false
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ENABLE_SEMANTIC_SEARCH=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_USD_PER_MINUTE=
AI_VOICE_USD_PER_MINUTE=
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=15000
