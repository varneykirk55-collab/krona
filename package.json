{
  "name": "krona-companion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private, voice-first personal companion with persistent PostgreSQL memory and authorized check-ins.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "setup:token": "tsx scripts/setup-token.ts",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.6.1",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.2",
    "openai": "^6.0.0",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "twilio": "^5.10.0",
    "ws": "^8.18.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sparticuz/chromium": "^140.0.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.17",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "5.1.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
